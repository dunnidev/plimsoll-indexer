# Postgres connection string. Locally: go run ./cmd/devdb
DATABASE_URL=postgres://plimsoll:plimsoll@localhost:54329/plimsoll?sslmode=disable
PORT=8080

STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# From plimsoll-contracts/deployments/testnet.json
COVERAGE_LEDGER_ID=CC2QQ7R4FLPHZP7KA5AO4IASXXICTG6N4GQXCXITTEBNYQEYTYXKMN4D
REPORTER_REGISTRY_ID=CCZCBR7MGSW5LGIEUQR5TU5Z7JQWBDEESB3RGPTRPMCBUMOISRPY7GOB
# First ledger to ingest. Clamped to RPC's ~7 day retention window.
START_LEDGER=5034380

# Secret seed of an account registered as SupplyPoster. Leave empty to run read-only.
SUPPLY_POSTER_SECRET=

INGEST_INTERVAL=10s
POST_INTERVAL=15m
REPOST_AFTER=6h
TOML_INTERVAL=6h
CORS_ORIGINS=*
LOG_LEVEL=info
